{
  "languages": {
    "C": {
      "language_servers": ["clangd"],
      "format_on_save": "on",
      "tab_size": 4
    },
    "C++": {
      "language_servers": ["clangd"],
      "format_on_save": "on",
      "tab_size": 4
    }
  },
  "lsp": {
    "clangd": {
      "initialization_options": {
        "clangd": {
          "compilationDatabasePath": "build",
          "extraArgs": [
            "-Isrc",
            "-Isrc/Callback",
            "-Isrc/Global",
            "-Isrc/Log",
            "-Isrc/Platform",
            "-Isrc/Platform/Linux",
            "-Isrc/Platform/Windows",
            "-Isrc/ProtocolServer",
            "-Isrc/Threadpool"
          ]
        }
      }
    }
  },
  "file_types": {
    "C": ["c", "h"],
    "C++": ["cpp", "hpp"]
  }
}
