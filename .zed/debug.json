      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "cmake configure (Debug) - Windows",
    "build": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "cmake -S . -B build -A x64 -DCMAKE_PREFIX_PATH=\"$PWD\\vcpkg_installed\\x64-windows-static\"",
      ],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "cmake rebuild configure (Debug) - Windows",
    "build": {
