[
  {
    "label": "cmake configure (Debug) - Linux",
    "build": {
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "cmake rebuild configure (Debug) - Linux",
    "build": {
      "command": "sh",
      "args": [
        "-c",
        "rm -rf build && cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug",
      ],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "cmake run native binary (Debug) test SockToSock - Linux",
    "build": {
      "command": "sh",
      "args": [
        "-c",
        "rm -rf build && cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j",
      ],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "program": "$ZED_WORKTREE_ROOT/build/SimpleProxy",
    "args": ["-c", "$ZED_WORKTREE_ROOT/test/SockToSock/config.sock.yml"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
